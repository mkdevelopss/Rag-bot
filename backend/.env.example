# ---- LLM provider: groq | gemini | openai -------------------------------
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional: any OpenAI-compatible URL (OpenRouter, Ollama, vLLM). Leave empty for the provider default.
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ---- Agent ---------------------------------------------------------------
# true = tool-calling agent (searches, reads documents, calls your app tools)
# false = classic single-search RAG (cheaper: one LLM call per answer)
AGENT_ENABLED=true
AGENT_MAX_STEPS=4
AGENT_CONFIG_PATH=agent_config.json
QUERY_REWRITE=true
HISTORY_MESSAGES=12

# ---- Security ------------------------------------------------------------
SETTINGS_PASSWORD_HASH=
ADMIN_BOOTSTRAP_KEY_HASH=
AUTH_COOKIE_SECURE=false
# name:sha256:namespace_glob entries, comma-separated.
# Create with: python -m app.cli generate-service-key --name marketbid --namespaces marketbid
SERVICE_API_KEYS=
CHAT_RATE_LIMIT_PER_MINUTE=30

# ---- Retrieval -----------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# For e5 models use "query: " / "passage: ". Reindex after changing the model.
EMBEDDING_QUERY_PREFIX=
EMBEDDING_PASSAGE_PREFIX=
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
SIMILARITY_THRESHOLD=0.25
HYBRID_SEARCH=true
MAX_CONTEXT_CHARS=12000
MAX_FILE_SIZE_MB=20

# ---- Infrastructure ------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
DATABASE_PATH=data/rag_chatbot.sqlite3
CHROMA_PATH=data/chroma_db
UPLOAD_PATH=data/uploads
